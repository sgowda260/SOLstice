# Devnet only. The application rejects any non-devnet endpoint.
SOLANA_RPC_URL=https://api.devnet.solana.com
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
PROGRAM_ID=
VERIFIER_KEYPAIR_PATH=/absolute/path/to/verifier-devnet.json
PAYER_KEYPAIR_PATH=/absolute/path/to/payer-devnet.json
RECIPIENT_KEYPAIR_PATH=/absolute/path/to/recipient-devnet.json
NEXT_PUBLIC_SPACETIMEDB_URI=ws://127.0.0.1:3001
NEXT_PUBLIC_SPACETIMEDB_DATABASE=condition-oracle
# Server-side settings for the Agentverse integration. Generate separate random
# values for production and configure the matching token in the Agentverse agent.
SPACETIMEDB_URI=ws://127.0.0.1:3001
SPACETIMEDB_DATABASE=condition-oracle
SPACETIMEDB_SERVER_TOKEN=
XAI_API_KEY=
XAI_MODEL=grok-4.3
ASI1_API_KEY=
AGENTVERSE_AGENT_ADDRESS=
AGENT_API_TOKEN=
